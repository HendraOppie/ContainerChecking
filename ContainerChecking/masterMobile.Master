<%@ Master Language="VB" AutoEventWireup="false" CodeBehind="masterMobile.master.vb" Inherits="ContainerChecking.masterMobile" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>

    <link rel="icon" href="~/Images/LogoAgility.png" />
</head>
<body>
    <form id="form1" runat="server">
        <div id="divHead" runat="server" style="width:300px;">
            <asp:Table runat="server" Width="300px" >
                <asp:TableRow VerticalAlign="Middle">
                    <asp:TableCell>
                        <asp:ImageButton ID="ibtLogoAgility" runat="server" ImageUrl="~/Images/LogoAgility.png" width="120px" />   
                    </asp:TableCell>
                    <asp:TableCell>
                        <asp:Label runat="server" Text="Container Checking" Font-Names="Calibri" Font-Bold="true" ForeColor="darkblue" Font-Size="18px"></asp:Label>
                    </asp:TableCell>
                </asp:TableRow>
            </asp:Table>

            <asp:Table runat="server" Width="300px" Font-Names="Calibri" GridLines="Both" BorderStyle="Solid" CellPadding="5" BorderColor="darkblue" >
                <asp:TableRow HorizontalAlign="Center" VerticalAlign="Middle">
                    <asp:TableCell Width="15%" >
                        <asp:ImageButton ID="ibtHome" runat="server" ImageUrl="~/Images/HomeIcon_001.png" Width="22px" /> 
                    </asp:TableCell>
                    <asp:TableCell Width="15%">
                        <asp:ImageButton ID="ibtUser" runat="server" ImageUrl="~/Images/UserIcon_001.png" Width="22px" />
                    </asp:TableCell>
                    <asp:TableCell Width="70%" HorizontalAlign="Left">
                        <asp:Label ID="lbUsername" runat="server" Text="[username]" font-names="Calibri" ></asp:Label>
                    </asp:TableCell>

                </asp:TableRow>

            </asp:Table>
        </div>
        <div id="divPageTitle" runat="server" style="width:300px; align-content:center">
            <asp:ContentPlaceHolder ID="cphHeader" runat="server">
            </asp:ContentPlaceHolder>
            <hr style="border-style:solid; border-color:darkblue" />
        </div>
        <div id="divPageContent" runat="server" style="width:300px">
            <asp:ContentPlaceHolder ID="cphContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>
        <asp:Panel runat="server" Width="300px" HorizontalAlign="Center">
            <br/>
            <asp:Label ID="Label1" runat="server" Font-Names="Calibri" Text=".::   I T   @   2 0 2 1   ::." Font-Size="Small" Font-Bold="true"></asp:Label>
        </asp:Panel>

    </form>
</body>
</html>
